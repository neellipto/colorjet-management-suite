# COLORJET ERP / Odoo Sync environment template
# Copy to .env in the hosting environment only. Never commit real secrets.

APP_ENV=production
APP_URL=https://erp.colorjet.example
APP_PORT=3000
APP_SECRET=<generate-strong-secret>
JWT_SECRET=<generate-strong-jwt-secret>

DATABASE_URL=<database-connection-url>
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=colorjet_erp
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_SSL_MODE=require

ODOO_URL=https://odoo.colorjet.example
ODOO_DB=<odoo-db-name>
ODOO_USERNAME=<odoo-api-user>
ODOO_API_KEY=<odoo-api-key>
ODOO_SYNC_ENABLED=true
ODOO_SYNC_INTERVAL_SECONDS=300
ODOO_SYNC_QUEUE_NAME=odoo-sync
ODOO_SYNC_MAX_RETRIES=5

REDIS_URL=<redis-url>
QUEUE_CONNECTION=redis

UPLOAD_DIR=/var/www/colorjet/uploads
MAX_UPLOAD_MB=25

FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-client-email>
FIREBASE_PRIVATE_KEY=<firebase-private-key>
WEBSOCKET_URL=wss://api.colorjet.example/ws

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMS_API_URL=<sms-api-url>
SMS_API_KEY=<sms-api-key>

CORS_ORIGINS=https://erp.colorjet.example
SESSION_COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
