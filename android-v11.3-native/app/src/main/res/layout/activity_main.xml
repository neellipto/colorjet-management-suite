<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ProgressBar
        android:id="@+id/loading_indicator"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true" />

    <WebView
        android:id="@+id/erp_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/native_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/nav_bar_background"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingTop="7dp"
        android:paddingEnd="7dp"
        android:paddingBottom="8dp">

        <TextView android:id="@+id/nav_home" style="@style/PremiumNavButton" android:text="⌂&#10;Home" />
        <TextView android:id="@+id/nav_attendance" style="@style/PremiumNavButton" android:text="✓&#10;Attendance" />
        <TextView android:id="@+id/nav_notifications" style="@style/PremiumNavButton" android:text="●&#10;Alerts" />
        <TextView android:id="@+id/nav_messages" style="@style/PremiumNavButton" android:text="✉&#10;Messages" />
        <TextView android:id="@+id/nav_more" style="@style/PremiumNavButton" android:text="▦&#10;More" />
    </LinearLayout>
</LinearLayout>
