<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <gradient android:angle="270" android:startColor="#F58220" android:endColor="#FF9D3F"/>
      <corners android:radius="16dp"/>
      <stroke android:width="1dp" android:color="#D9680B"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#DFF3FF"/>
      <corners android:radius="16dp"/>
      <stroke android:width="1dp" android:color="#B8DFF5"/>
    </shape>
  </item>
</selector>