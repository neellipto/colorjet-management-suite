{
  "expo": {
    "name": "COLORJET Management Suite",
    "slug": "colorjet-management-suite",
    "version": "1.7.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colorjet-erp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A237E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.colorjetbd.managementsuite",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "COLORJET uses your location to verify attendance and customer-site visits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "During an active assigned field visit, COLORJET records the route with a visible tracking indicator."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.colorjetbd.managementsuite",
      "versionCode": 1721,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A237E"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "During an active assigned field visit, COLORJET records your route with a visible notification.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ea419f70-a1b3-4265-9e21-5461341ab541"
      },
      "firebaseAndroidAppId": "1:475854312836:android:c68d85ee194443660c39d1"
    },
    "owner": "neellipto"
  }
}
