{
  "expo": {
    "name": "COLORJET ERP",
    "slug": "colorjet-management-suite",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colorjet-erp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A237E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.colorjetbd.managementsuite",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "COLORJET uses your location to verify attendance and customer-site visits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "During an active assigned field visit, COLORJET records the route with a visible tracking indicator."
      }
    },
    "android": {
      "package": "com.colorjetbd.managementsuite",
      "versionCode": 1200,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "During an active assigned field visit, COLORJET records your route with a visible notification.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
